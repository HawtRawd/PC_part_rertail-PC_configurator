<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="BuildController">

    <right>
        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f4f4f4; -fx-border-color: #ccc; -fx-border-width: 0 0 0 1;">
            <Label text="Build Summary" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Separator/>

            <HBox spacing="10">
                <Label text="Total Price:" style="-fx-font-weight: bold;"/>
                <Label fx:id="totalPriceLabel" text="0.00$"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Est. Wattage:" style="-fx-font-weight: bold;"/>
                <Label fx:id="wattageLabel" text="0W"/>
            </HBox>

            <Label text="Compatibility Notes:" style="-fx-underline: true;"/>
            <Label fx:id="errorLabel" text="No issues found." textFill="green" wrapText="true" maxWidth="200"/>

            <Region VBox.vgrow="ALWAYS"/> <Button fx:id="saveButton" text="Save Build" maxWidth="Infinity" style="-fx-background-color: #27ae60;" textFill="white" disable="true"/>
        </VBox>
    </right>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-padding: 20;">
            <GridPane hgap="20" vgap="15">

                <Label text="CPU" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="cpuName" text="None Selected" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label fx:id="cpuPrice" text="-" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <Button text="Add CPU" onAction="#handleSelectCpu" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="Motherboard" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="moboName" text="None Selected" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label fx:id="moboPrice" text="-" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <Button text="Add Mobo" onAction="#handleSelectMobo" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <Label text="Cooler" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="coolerName" text="None Selected" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label fx:id="coolerPrice" text="-" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                <Button text="Add Cooler" onAction="#handleSelectCooler" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                <Label text="RAM Kit(s)" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <VBox fx:id="ramContainer" spacing="5" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="" GridPane.rowIndex="3" GridPane.columnIndex="2"/> <Button text="+" onAction="#handleAddRam" GridPane.rowIndex="3" GridPane.columnIndex="3"/>

                <Label text="Storage" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <VBox fx:id="storageContainer" spacing="5" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                <Label text="" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
                <Button text="+" onAction="#handleAddStorage" GridPane.rowIndex="4" GridPane.columnIndex="3"/>

                <Label text="Graphics Card(s)" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <VBox fx:id="gpuContainer" spacing="5" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                <Label text="" GridPane.rowIndex="5" GridPane.columnIndex="2"/>
                <Button text="+" onAction="#handleAddGpu" GridPane.rowIndex="5" GridPane.columnIndex="3"/>

                <Label text="Power Supply" GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="psuName" text="None Selected" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                <Label fx:id="psuPrice" text="-" GridPane.rowIndex="6" GridPane.columnIndex="2"/>
                <Button text="Add PSU" onAction="#handleSelectPsu" GridPane.rowIndex="6" GridPane.columnIndex="3"/>

                <Label text="Case" GridPane.rowIndex="7" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="caseName" text="None Selected" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                <Label fx:id="casePrice" text="-" GridPane.rowIndex="7" GridPane.columnIndex="2"/>
                <Button text="Add Case" onAction="#handleSelectCase" GridPane.rowIndex="7" GridPane.columnIndex="3"/>

                <Label text="Accessories" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                <VBox fx:id="accessoryContainer" spacing="5" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
                <Label text="" GridPane.rowIndex="8" GridPane.columnIndex="2"/>
                <Button text="+" onAction="#handleAddAccessory" GridPane.rowIndex="8" GridPane.columnIndex="3"/>

            </GridPane>
        </ScrollPane>
    </center>

</BorderPane>