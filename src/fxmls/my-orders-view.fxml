<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.OrderHistoryController">

    <top>
        <HBox style="-fx-background-color: #333; -fx-padding: 20; -fx-alignment: CENTER_LEFT;">
            <Label text="My Order History" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back to Dashboard" onAction="#handleBack"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: white; -fx-border-radius: 5;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-padding: 20; -fx-background-color: #f4f4f4;">
            <content>
                <VBox fx:id="ordersContainer" spacing="20" alignment="TOP_CENTER">
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>