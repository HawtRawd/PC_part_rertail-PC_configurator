<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.UserBuildsController">

    <top>
        <HBox style="-fx-padding: 20; -fx-background-color: #333; -fx-alignment: CENTER_LEFT;">
            <Label text="My Saved Configurations" style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back to Dashboard" onAction="#handleBack"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: white; -fx-border-radius: 5;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <content>
                <VBox fx:id="buildsContainer" spacing="15" alignment="TOP_CENTER" style="-fx-padding: 30; -fx-background-color: #f4f4f4;">

                    <Button fx:id="createNewBtn" text="+ Create New Build" onAction="#handleCreateNew"
                            style="-fx-font-size: 16px; -fx-padding: 15 30; -fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>