<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.BuildController">

    <right>
        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f4f4f4; -fx-border-color: #ccc; -fx-border-width: 0 0 0 1;">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Build Summary" />

            <Separator />

            <HBox spacing="10">
                <Label style="-fx-font-weight: bold;" text="Total Price:" />
                <Label fx:id="totalPriceLabel" text="0.00$" />
            </HBox>

            <HBox spacing="10">
                <Label style="-fx-font-weight: bold;" text="Est. Wattage:" />
                <Label fx:id="wattageLabel" text="0W" />
            </HBox>

            <Label style="-fx-underline: true;" text="Compatibility Notes:" />
            <Label fx:id="errorLabel" maxWidth="200" text="No issues found." textFill="green" wrapText="true" />

            <Region VBox.vgrow="ALWAYS" /> <Button fx:id="saveButton" disable="true" maxWidth="Infinity" onAction="#handleSave" prefHeight="26.0" prefWidth="138.0" style="-fx-background-color: #27ae60;" text="Save Build" textFill="white" />
            <Region VBox.vgrow="ALWAYS" /> <Button fx:id="exitButton" disable="false" maxWidth="Infinity" onAction="#handleExit" prefHeight="26.0" prefWidth="138.0" style="-fx-background-color: #FF0000;" text="Exit Build" textFill="white" />
        </VBox>
    </right>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-padding: 20;">
            <GridPane hgap="20" vgap="15">

                <Label style="-fx-font-weight: bold;" text="CPU" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="cpuName" text="None Selected" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label fx:id="cpuPrice" text="-" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <Button onAction="#handleSelectCpu" text="Add CPU" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                <Label style="-fx-font-weight: bold;" text="Motherboard" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label fx:id="moboName" text="None Selected" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label fx:id="moboPrice" text="-" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <Button onAction="#handleSelectMobo" text="Add Mobo" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                <Label style="-fx-font-weight: bold;" text="Cooler" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Label fx:id="coolerName" text="None Selected" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label fx:id="coolerPrice" text="-" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                <Button onAction="#handleSelectCooler" text="Add Cooler" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                <Label text="RAM Kit(s)" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <VBox fx:id="ramContainer" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label text="" GridPane.columnIndex="2" GridPane.rowIndex="3" /> <Button onAction="#handleAddRam" text="+" GridPane.columnIndex="3" GridPane.rowIndex="3" />

                <Label text="Storage" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <VBox fx:id="storageContainer" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                <Label text="" GridPane.columnIndex="2" GridPane.rowIndex="4" />
                <Button onAction="#handleAddStorage" text="+" GridPane.columnIndex="3" GridPane.rowIndex="4" />

                <Label text="Graphics Card(s)" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <VBox fx:id="gpuContainer" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                <Label text="" GridPane.columnIndex="2" GridPane.rowIndex="5" />
                <Button onAction="#handleAddGpu" text="+" GridPane.columnIndex="3" GridPane.rowIndex="5" />

                <Label style="-fx-font-weight: bold;" text="Power Supply" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                <Label fx:id="psuName" text="None Selected" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                <Label fx:id="psuPrice" text="-" GridPane.columnIndex="2" GridPane.rowIndex="6" />
                <Button onAction="#handleSelectPsu" text="Add PSU" GridPane.columnIndex="3" GridPane.rowIndex="6" />

                <Label style="-fx-font-weight: bold;" text="Case" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                <Label fx:id="caseName" text="None Selected" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                <Label fx:id="casePrice" text="-" GridPane.columnIndex="2" GridPane.rowIndex="7" />
                <Button onAction="#handleSelectCase" text="Add Case" GridPane.columnIndex="3" GridPane.rowIndex="7" />

                <Label text="Accessories" GridPane.columnIndex="0" GridPane.rowIndex="8" />
                <VBox fx:id="accessoryContainer" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="8" />
                <Label text="" GridPane.columnIndex="2" GridPane.rowIndex="8" />
                <Button onAction="#handleAddAccessory" text="+" GridPane.columnIndex="3" GridPane.rowIndex="8" />
            <columnConstraints>
               <ColumnConstraints />
               <ColumnConstraints />
               <ColumnConstraints />
               <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>

            </GridPane>
        </ScrollPane>
    </center>

</BorderPane>
