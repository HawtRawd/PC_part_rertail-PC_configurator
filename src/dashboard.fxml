<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="DashboardController"
            prefHeight="600.0" prefWidth="900.0">

    <left>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
            <Label text="PC BUILDER" textFill="white" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Separator/>
            <Button text="Browse Parts" maxWidth="Infinity" onAction="#showProducts"/>
            <Button text="My Builds" maxWidth="Infinity"/> <Region VBox.vgrow="ALWAYS"/> <Button text="Logout" maxWidth="Infinity" style="-fx-background-color: #e74c3c;" textFill="white" onAction="#logout"/>
        </VBox>
    </left>

    <top>
        <HBox spacing="20" style="-fx-padding: 15; -fx-background-color: #ecf0f1;" alignment="CENTER_LEFT">
            <Label fx:id="welcomeLabel" text="Welcome, User" style="-fx-font-size: 16px;"/>
            <Region HBox.hgrow="ALWAYS"/> <TextField fx:id="searchField" promptText="Search components..." prefWidth="300"/>
            <Button text="Search" onAction="#handleSearch"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="productTable">
            <columns>
                <TableColumn fx:id="colName" text="Component Name" prefWidth="250"/>
                <TableColumn fx:id="colCategory" text="Category" prefWidth="150"/>
                <TableColumn fx:id="colManufacturer" text="Brand" prefWidth="150"/>
                <TableColumn fx:id="colPrice" text="Price" prefWidth="100"/>
                <TableColumn fx:id="colStock" text="Stock" prefWidth="80"/>
            </columns>
        </TableView>
    </center>

</BorderPane>